{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": ["CI", "NEXT_PUBLIC_*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**", "!dist/cache/**"],
      "env": ["SENTRY_AUTH_TOKEN"]
    },
    "lint": {
      "dependsOn": ["@bluedot/eslint-config#build"]
    },
    "lint:fix": {
      "cache": false
    },
    "typecheck": {
      "cache": false
    },
    "test": {},
    "test:ui": {
      "cache": false,
      "env": ["PORTAL_TEST_URL"]
    },
    "test:candidate-ui": {
      "cache": false,
      "env": ["PORTAL_TEST_URL", "CANDIDATE_TEST_ENGINE_URL", "UI_OUTPUT_DIR"]
    },
    "start": {
      "cache": false,
      "persistent": true,
      "env": ["NODE_ENV", "CANDIDATE_SOURCING_URL"]
    },
    "@bluedot/infra#deploy:cd": {
      "cache": false,
      "env": ["ASHBY_API_KEY"]
    }
  }
}
