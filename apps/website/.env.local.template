# Calendar Connect: members connect a Google Calendar so we can schedule 1-1 chats at times they're free.
# Only needed when working on /account/calendars/connect or /api/calendar-connections/*.
# OAuth web client "Calendar Connect" in the bluedot-prod Google Cloud project. Its redirect URIs are
# {NEXT_PUBLIC_SITE_URL}/api/calendar-connections/google/callback for bluedot.org and localhost:8000.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Verifies the signed Slack user ID in connect links. Same value as BLUEDOT_LINK_SECRET in bluedotimpact/dot-to-dot.
CALENDAR_CONNECT_LINK_SECRET=
# Encrypts stored refresh tokens (AES-256-GCM). 32 random bytes, base64: `openssl rand -base64 32`.
# Changing it makes every stored connection unreadable, so members would have to reconnect.
CALENDAR_CONNECT_ENCRYPTION_KEY=
# Bearer secret for POST /api/calendar-connections/busy. Same value as BLUEDOT_BUSY_API_SECRET in dot-to-dot.
CALENDAR_CONNECT_BUSY_API_SECRET=

# First Contact: bluedot.org/welcome books each new hire five 30-minute chats with teammates in #welcome.
# Uses the Calendar Connect OAuth client above. Its redirect URIs also need {NEXT_PUBLIC_SITE_URL}/api/welcome/google/callback.
# The shared password people type on the page.
WELCOME_PASSWORD=
# Bot token of the "First Contact" Slack app (apps/website/scripts/first-contact/slack-manifest.yml).
WELCOME_SLACK_BOT_TOKEN=
# #welcome. Teammates in it with a bluedot.org email are the people new hires meet. The bot posts each welcome there.
WELCOME_SLACK_CHANNEL_ID=
# dewi-bots@bluedot.org's refresh token and its "First Contact" calendar, from scripts/first-contact/authorize.ts.
WELCOME_GOOGLE_REFRESH_TOKEN=
WELCOME_GOOGLE_CALENDAR_ID=

