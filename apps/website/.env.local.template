# Calendar Connect: members connect a Google or Outlook calendar so we can schedule 1-1 chats at times they're free.
# Only needed when working on /account/calendars/connect or /api/calendar-connections/*.
# OAuth web client "Calendar Connect" in the bluedot-prod Google Cloud project. Its redirect URIs are
# {NEXT_PUBLIC_SITE_URL}/api/calendar-connections/google/callback for bluedot.org and localhost:8000.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# App registration "BlueDot Calendar Connect" in BlueDot's Microsoft Entra directory, for Outlook calendars.
# Supported accounts: any organisation's directory plus personal Microsoft accounts. Its redirect URIs are
# {NEXT_PUBLIC_SITE_URL}/api/calendar-connections/microsoft/callback for bluedot.org, staging and localhost:8000.
# Optional: without these, /account/calendars only offers Google. The secret expires, so rotate it before it does.
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
# Verifies the signed Slack user ID in connect links. Same value as BLUEDOT_LINK_SECRET in bluedotimpact/dot-to-dot.
CALENDAR_CONNECT_LINK_SECRET=
# Encrypts stored refresh tokens (AES-256-GCM). 32 random bytes, base64: `openssl rand -base64 32`.
# Changing it makes every stored connection unreadable, so members would have to reconnect.
CALENDAR_CONNECT_ENCRYPTION_KEY=
# Bearer secret for POST /api/calendar-connections/busy. Same value as BLUEDOT_BUSY_API_SECRET in dot-to-dot.
CALENDAR_CONNECT_BUSY_API_SECRET=

