{
  "name": "@bluedot/team-apps",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "shx cp -n .env.local.template .env.local",
    "start": "next dev --hostname localhost -p 8000",
    "start:docker": "docker-scripts start",
    "typecheck": "tsc --noEmit",
    "build": "next build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest --run",
    "test:watch": "vitest",
    "deploy:cd": "docker-scripts deploy",
    "start:preview": "NEXT_PUBLIC_LOCAL_PREVIEW=true next dev --hostname localhost -p 8000",
    "test:ui": "node tools/check-ui.mjs",
    "start:candidate-engine": "cd candidate-sourcing && python3 -B -m talent_sourcing",
    "test:candidate-engine": "cd candidate-sourcing && python3 -B -m unittest discover -s tests -v",
    "test:candidate-ui": "node tools/check-candidate-ui.mjs",
    "start:candidate-preview": "cd candidate-sourcing && python3 -B tools/ui_fixture.py --demo --port 8770"
  },
  "dependencies": {
    "@bluedot/db": "*",
    "@bluedot/ui": "*",
    "@bluedot/utils": "*",
    "axios": "^1.7.2",
    "axios-hooks": "^5.0.2",
    "http-errors": "^2.0.0",
    "next": "^15.5.9",
    "react": "^18.2.0",
    "react-confetti": "^6.4.0",
    "react-dom": "^18.2.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.4",
    "@trpc/client": "^11.6.0",
    "@trpc/server": "^11.6.0"
  },
  "devDependencies": {
    "@bluedot/docker-scripts": "*",
    "@bluedot/eslint-config": "*",
    "@bluedot/typescript-config": "*",
    "@tailwindcss/postcss": "^4.0.6",
    "@testing-library/react": "^15.0.2",
    "@types/node": "^22.13.2",
    "@types/react": "^18.0.22",
    "@types/react-dom": "^18.0.7",
    "@vitejs/plugin-react": "^4.2.1",
    "dotenv": "^16.4.5",
    "eslint": "^9.39.2",
    "happy-dom": "^18.0.1",
    "node-mocks-http": "^1.14.1",
    "playwright": "1.58.2",
    "postcss": "^8.4.38",
    "shx": "^0.4.0",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3"
  }
}
